# These are environment variables. Enter them on your host's "Environment" settings page (Render, Railway
# and Fly all have one). The app does not read a .env file by itself.
# Nothing here is needed to try the simulator on your own computer.

# --- Always set these when the app is on the internet ---
# A long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The public address of the app, no trailing slash.
BASE_URL=https://your-app.example.com
DATABASE_PATH=/data/jobping.db
# Set to 1 when the host puts a proxy in front of the app (Render, Railway, Fly).
TRUST_PROXY=1

# --- Real texting (leave as console until you finish the README's go-live steps) ---
SMS_PROVIDER=console
SMS_ENABLED=1
SIMULATOR=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional ---
# Leave sign-up OFF with live texting; create accounts with: flask --app wsgi create-business
ALLOW_SIGNUP=0
# Only texts to numbers starting with this are sent.
ALLOWED_PREFIX=+1
SCREEN_CALLS=1
# Needed only if an outside scheduler calls POST /internal/tick.
CRON_SECRET=
# Safety limits (the defaults are usually right).
MAX_TEXTS_PER_NUMBER_PER_DAY=6
MAX_AUTO_TEXTS_PER_BUSINESS_PER_DAY=200
MAX_FIRST_TEXTS_PER_BUSINESS_PER_DAY=40
MAX_OWNER_ALERTS_PER_BUSINESS_PER_DAY=30
